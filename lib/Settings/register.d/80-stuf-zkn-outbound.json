{
    "_note": "SHAPE FIX. This fragment declared `registers` and `schemas` at the TOP level, while RegisterFragmentMerger merges onto `components` and OpenRegister's importer reads `components.registers` / `components.schemas`. The whole fragment was therefore invisible: stufEndpoint, stufMessage and zaaksysteemMapping were never created and never carried, and StufRegisterAccess failed 46 times on one measured fresh install with `Schema slug \"stufEndpoint\"/\"stufMessage\" is not carried by register \"dossiq\"`. Nothing said a word at install time. The single demo endpoint stays parked under `components._objects_disabled` rather than being un-parked alongside the schemas: it is one municipality's connection profile with placeholder credentials, and shipping it on every install is a product decision nobody made. Rename it back to `objects` to seed it.",
    "components": {
        "registers": {
            "dossiq": {
                "schemas": [
                    "stufEndpoint",
                    "stufMessage",
                    "zaaksysteemMapping"
                ]
            }
        },
        "schemas": {
            "stufEndpoint": {
                "slug": "stufEndpoint",
                "title": "StUF Endpoint",
                "icon": "Connection",
                "version": "1.0.0",
                "summary": "Configuration profile for a single zaaksysteem StUF connection.",
                "description": "Stores the connection details (URL, sectormodel, authentication, TLS cert reference) for one legacy zaaksysteem reachable over StUF 0310. Multiple endpoints per gemeente are supported (transition scenarios).",
                "@type": "StufEndpoint",
                "required": [
                    "id",
                    "name",
                    "municipalityCode",
                    "recipientApplication",
                    "recipientOrganisation",
                    "recipientUser",
                    "senderApplication",
                    "senderOrganisation",
                    "endpointUrl",
                    "soapVersion",
                    "stufVersion",
                    "sectorModel",
                    "authentication"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Endpoint ID",
                        "description": "Stable identifier of this endpoint (e.g. stuf-ep-amersfoort-key2zaken).",
                        "maxLength": 128
                    },
                    "name": {
                        "type": "string",
                        "title": "Endpoint name",
                        "description": "Human-readable endpoint name shown in the admin UI.",
                        "maxLength": 255
                    },
                    "municipalityCode": {
                        "type": "string",
                        "title": "Municipality code",
                        "description": "4-digit gemeente CBS code (e.g. 0307 for Amersfoort).",
                        "maxLength": 16
                    },
                    "recipientApplication": {
                        "type": "string",
                        "title": "Recipient application",
                        "description": "Receiving zaaksysteem application name (StUF stuurgegevens.ontvanger.applicatie).",
                        "maxLength": 255
                    },
                    "recipientOrganisation": {
                        "type": "string",
                        "title": "Recipient organisation",
                        "description": "Receiving organisation (gemeente).",
                        "maxLength": 255
                    },
                    "recipientUser": {
                        "type": "string",
                        "title": "Recipient user",
                        "description": "Receiving system user identifier.",
                        "maxLength": 255
                    },
                    "senderApplication": {
                        "type": "string",
                        "title": "Sender application",
                        "description": "Sender (Dossiq) application identifier.",
                        "maxLength": 255
                    },
                    "senderOrganisation": {
                        "type": "string",
                        "title": "Sender organisation",
                        "description": "Sender organisation (gemeente).",
                        "maxLength": 255
                    },
                    "endpointUrl": {
                        "type": "string",
                        "title": "Endpoint URL",
                        "description": "SOAP endpoint URL (HTTPS only, validated).",
                        "format": "uri",
                        "maxLength": 1024
                    },
                    "soapVersion": {
                        "type": "string",
                        "title": "SOAP version",
                        "description": "SOAP envelope version.",
                        "enum": [
                            "1.1",
                            "1.2"
                        ]
                    },
                    "stufVersion": {
                        "type": "string",
                        "title": "StUF version",
                        "description": "StUF protocol version.",
                        "enum": [
                            "0310"
                        ]
                    },
                    "sectorModel": {
                        "type": "string",
                        "title": "Sector model",
                        "description": "StUF sectormodel; ZKN for cases.",
                        "enum": [
                            "ZKN"
                        ]
                    },
                    "authentication": {
                        "type": "object",
                        "title": "Authentication",
                        "description": "Authentication block (WSSE UsernameToken). The password itself is never stored in the schema; only the vault reference is persisted.",
                        "required": [
                            "type",
                            "username",
                            "passwordVaultRef"
                        ],
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Authentication type",
                                "description": "How this endpoint authenticates. WSSE UsernameToken is the StUF default.",
                                "enum": [
                                    "wsse-usernametoken"
                                ]
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "description": "The user name sent in the WSSE token. The password lives in the vault, never here.",
                                "maxLength": 255
                            },
                            "passwordVaultRef": {
                                "type": "string",
                                "title": "Password vault reference",
                                "description": "Vault reference (e.g. vault://stuf/amersfoort/key2zaken).",
                                "maxLength": 512
                            }
                        }
                    },
                    "tlsClientCertRef": {
                        "type": "string",
                        "title": "Client certificate reference",
                        "description": "Vault reference for the mutual-TLS client certificate (PEM).",
