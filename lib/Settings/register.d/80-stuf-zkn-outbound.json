                    },
                    "caseIdentificationStrategy": {
                        "type": "string",
                        "title": "Case ID strategy",
                        "description": "Zaak ID allocation strategy (vooraf = pre-allocate via Du01; achteraf = server allocates on Lk01).",
                        "enum": [
                            "vooraf",
                            "achteraf"
                        ]
                    },
