                            "required": [
                                "name",
                                "verplichteVelden"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Template name",
                                    "description": "The name this free-message template is chosen by."
                                },
                                "verplichteVelden": {
                                    "type": "array",
                                    "title": "Required fields",
                                    "description": "Fields a sender fills before this template can go out.",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "actief": {
                        "type": "boolean",
                        "title": "Active",
                        "description": "Whether this endpoint is active. Soft-delete sets actief=false.",
                        "default": true
                    },
                    "aangemaakt": {
                        "type": "string",
                        "title": "Created",
                        "format": "date-time",
                        "description": "Timestamp when the endpoint was created."
                    }
                }
            },
            "stufMessage": {
                "slug": "stufMessage",
