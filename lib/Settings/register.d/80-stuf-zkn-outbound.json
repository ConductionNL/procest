                                    "format": "date-time"
                                },
                                "httpStatus": {
                                    "type": "integer",
                                    "title": "HTTP status",
                                    "description": "The status this retry received."
                                },
                                "durationMs": {
                                    "type": "integer",
                                    "title": "Duration in ms",
