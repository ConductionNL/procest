{
  "name": "dossiq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:manifest": "node tests/validate-manifest.js",
    "test:unit:watch": "vitest",
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "postbuild": "node scripts/check-single-dexie.js",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src tests scripts",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"{src,css}/**/*.{vue,scss,css}\"",
    "stylelint-fix": "stylelint 'src/**/*.vue' 'src/**/*.scss' 'src/**/*.css' --fix",
    "test:zgw": "cd tests/zgw && bash run-zgw-tests.sh",
    "test:zgw:oas": "cd tests/zgw && bash run-zgw-tests.sh --oas-only",
    "test:zgw:business": "cd tests/zgw && bash run-zgw-tests.sh --business-only",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium",
    "check:vue3-compile": "node scripts/vue3-compile-sweep.cjs",
    "check:dexie": "node scripts/check-single-dexie.js",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "^2.37.0",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "~2.6.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vue/compat": "^3.5.13",
    "@vueuse/core": "^14.4.0",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.12",
    "gridstack": "^13.2.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "marked": "^18.0.11",
    "pinia": "^3.0.3",
    "proj4": "^2.22.0",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "@nextcloud/axios": "$@nextcloud/axios"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "commander": "^15.0.0",
    "css-loader": "~7.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "node-polyfill-webpack-plugin": "4.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "~4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.3.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^6.0.1"
  },
  "prettier": "@nextcloud/prettier-config"
}
